@namespace Frontend.Shared.Components

<div class="toast-container">
    @if (IsVisible)
    {
        <div class="toast toast-@Type.ToString().ToLower() @(IsVisible ? "show" : "")">
            <div class="toast-content">
                @if (Type == ToastType.Success)
                {
                    <svg class="toast-icon" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                            clip-rule="evenodd"></path>
                    </svg>
                }
                else if (Type == ToastType.Error)
                {
                    <svg class="toast-icon" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                            d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                            clip-rule="evenodd"></path>
                    </svg>
                }
                <span>@Message</span>
            </div>
            <button @onclick="Hide" class="toast-close">
                <svg fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                        d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                        clip-rule="evenodd"></path>
                </svg>
            </button>
        </div>
    }
</div>

<style>
    .toast-container {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 1000;
    }

    .toast {
        display: flex;
        align-items: center;
        background: white;
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        min-width: 300px;
        padding: 16px;
        transform: translateX(100%);
        transition: transform 0.3s ease-in-out;
    }

    .toast.show {
        transform: translateX(0);
    }

    .toast-success {
        border-left: 4px solid #10b981;
        color: #065f46;
    }

    .toast-error {
        border-left: 4px solid #ef4444;
        color: #7f1d1d;
    }

    .toast-content {
        display: flex;
        align-items: center;
        flex: 1;
    }

    .toast-icon {
        width: 20px;
        height: 20px;
        margin-right: 12px;
    }

    .toast-close {
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        margin-left: 12px;
    }

    .toast-close svg {
        width: 16px;
        height: 16px;
        color: #6b7280;
    }
</style>

@code {
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public ToastType Type { get; set; } = ToastType.Success;
    [Parameter] public bool IsVisible { get; set; } = false;
    [Parameter] public EventCallback OnHide { get; set; }

    public enum ToastType
    {
        Success,
        Error
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible)
        {
            await Task.Delay(5000); // Auto hide after 5 seconds
            await Hide();
        }
    }

    private async Task Hide()
    {
        IsVisible = false;
        await OnHide.InvokeAsync();
        StateHasChanged();
    }

    public async Task ShowSuccess(string message)
    {
        Message = message;
        Type = ToastType.Success;
        IsVisible = true;
        StateHasChanged();

        await Task.Delay(5000);
        await Hide();
    }

    public async Task ShowError(string message)
    {
        Message = message;
        Type = ToastType.Error;
        IsVisible = true;
        StateHasChanged();

        await Task.Delay(5000);
        await Hide();
    }
}