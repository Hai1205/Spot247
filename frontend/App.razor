<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Không tìm thấy trang - Spot247</PageTitle>
        <LayoutView Layout="@typeof(AuthLayout)">
            <div class="text-center">
                <h1 class="text-white text-2xl font-bold mb-4">404 - Không tìm thấy trang</h1>
                <p class="text-gray-400 mb-6">Xin lỗi, trang bạn tìm kiếm không tồn tại.</p>
                <a href="/login" class="text-blue-400 hover:text-blue-300 underline">Về trang đăng nhập</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
