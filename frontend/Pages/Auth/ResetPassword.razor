@page "/reset-password"
@layout AuthLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Đặt lại mật khẩu - Spot247</PageTitle>

<div>
    <h1 class="text-white text-2xl font-bold text-center mb-8">
        Đặt lại mật khẩu
    </h1>

    <EditForm Model="@resetPasswordRequest" OnValidSubmit="@HandleResetPassword">
        <DataAnnotationsValidator />
        
        <div class="space-y-6">
            <div>
                <label for="newPassword" class="block text-sm font-medium text-gray-300 mb-2">
                    Mật khẩu mới
                </label>
                <InputText @bind-Value="resetPasswordRequest.Password" 
                          type="password"
                          id="newPassword"
                          placeholder="Nhập mật khẩu mới"
                          class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-white placeholder-gray-400" />
                <ValidationMessage For="@(() => resetPasswordRequest.Password)" class="mt-1 text-sm text-red-400" />
            </div>

            <div>
                <label for="confirmPassword" class="block text-sm font-medium text-gray-300 mb-2">
                    Xác nhận mật khẩu
                </label>
                <InputText @bind-Value="resetPasswordRequest.ConfirmPassword" 
                          type="password"
                          id="confirmPassword"
                          placeholder="Nhập lại mật khẩu mới"
                          class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-white placeholder-gray-400" />
                <ValidationMessage For="@(() => resetPasswordRequest.ConfirmPassword)" class="mt-1 text-sm text-red-400" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mb-4 p-3 bg-red-900/50 border border-red-700 rounded-md">
                    <p class="text-red-300 text-sm">@errorMessage</p>
                </div>
            }

            <ButtonComponent 
                Type="submit"
                Text="Đặt lại mật khẩu"
                LoadingText="Đang đặt lại..."
                IsLoading="@AuthService.IsLoading"
                Disabled="@AuthService.IsLoading"
                CssClass="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-4 rounded-md transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed" />
        </div>
    </EditForm>
</div>

<ToastComponent @ref="toastComponent" />

@code {
    private ResetPasswordRequest resetPasswordRequest = new();
    private string errorMessage = string.Empty;
    private ToastComponent? toastComponent;

    protected override async Task OnInitializedAsync()
    {
        // Lấy email từ query string
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var queryStrings = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        
        if (queryStrings.TryGetValue("email", out var email))
        {
            resetPasswordRequest.Username = email.ToString();
        }
        
        // Nếu đã đăng nhập, chuyển hướng đến trang chính
        if (AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/");
        }

        AuthService.OnAuthStateChanged += StateHasChanged;
    }

    private async Task HandleResetPassword()
    {
        errorMessage = string.Empty;

        try
        {
            var result = await AuthService.ResetPasswordAsync(resetPasswordRequest);

            if (result == null)
            {
                errorMessage = "Có lỗi xảy ra, vui lòng thử lại";
                return;
            }

            if (result.StatusCode == 200)
            {
                // Đặt lại mật khẩu thành công
                if (toastComponent != null)
                {
                    await toastComponent.ShowSuccess("Đổi mật khẩu thành công");
                }
                
                await Task.Delay(2000); // Đợi một chút để hiển thị thông báo
                Navigation.NavigateTo("/login");
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Có lỗi xảy ra, vui lòng thử lại";
            Console.WriteLine($"Reset password error: {ex.Message}");
        }
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= StateHasChanged;
    }
}