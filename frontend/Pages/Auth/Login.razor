@page "/login"
@layout AuthLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Đăng nhập - Spot247</PageTitle>

<div>
    <h1 class="text-white text-2xl font-bold text-center mb-8">
        Đăng nhập
    </h1>

    <EditForm Model="@loginRequest" OnValidSubmit="@HandleLogin">
        <DataAnnotationsValidator />

        <div class="space-y-6">
            <div>
                <label for="email" class="block text-sm font-medium text-gray-300 mb-2">
                    Email
                </label>
                <InputText @bind-Value="loginRequest.Username" id="email" placeholder="Nhập email của bạn"
                    class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-white placeholder-gray-400" />
                <ValidationMessage For="@(() => loginRequest.Username)" class="mt-1 text-sm text-red-400" />
            </div>

            <div>
                <label for="password" class="block text-sm font-medium text-gray-300 mb-2">
                    Mật khẩu
                </label>
                <InputText @bind-Value="loginRequest.Password" type="password" id="password"
                    placeholder="Nhập mật khẩu của bạn"
                    class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-white placeholder-gray-400" />
                <ValidationMessage For="@(() => loginRequest.Password)" class="mt-1 text-sm text-red-400" />
            </div>

            <div class="mb-6">
                <a href="/forgot-password"
                    class="@(AuthService.IsLoading ? "pointer-events-none opacity-70" : "") text-blue-400 hover:text-blue-300 text-sm underline cursor-pointer">
                    Quên mật khẩu?
                </a>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mb-4 p-3 bg-red-900/50 border border-red-700 rounded-md">
                    <p class="text-red-300 text-sm">@errorMessage</p>
                </div>
            }

            <ButtonComponent Type="submit" Text="Đăng nhập" LoadingText="Đang đăng nhập..."
                IsLoading="@AuthService.IsLoading" Disabled="@AuthService.IsLoading"
                CssClass="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-4 rounded-md transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed" />
        </div>
    </EditForm>

    <div class="mt-6 text-center">
        <p class="text-gray-400 text-sm">
            Chưa có tài khoản?
            <a href="/register"
                class="@(AuthService.IsLoading ? "pointer-events-none opacity-70" : "") text-blue-400 hover:text-blue-300 underline cursor-pointer">
                Đăng ký ngay
            </a>
        </p>
    </div>
</div>

<ToastComponent @ref="toastComponent" />

@code {
    private LoginRequest loginRequest = new();
    private string errorMessage = string.Empty;
    private ToastComponent? toastComponent;

    protected override async Task OnInitializedAsync()
    {
        // Nếu đã đăng nhập, chuyển hướng đến trang chính
        if (AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/");
        }

        AuthService.OnAuthStateChanged += StateHasChanged;
    }

    private async Task HandleLogin()
    {
        errorMessage = string.Empty;

        try
        {
            var result = await AuthService.LoginAsync(loginRequest);

            if (result == null)
            {
                errorMessage = "Có lỗi xảy ra, vui lòng thử lại";
                return;
            }

            if (result.StatusCode == 401)
            {
                // Cần xác thực OTP
                await AuthService.SendOtpAsync(loginRequest.Username);
                Navigation.NavigateTo($"/verify-email?email={Uri.EscapeDataString(loginRequest.Username)}&isPasswordReset=false");
                return;
            }

            if (result.StatusCode == 200)
            {
                // Đăng nhập thành công
                if (toastComponent != null)
                {
                    await toastComponent.ShowSuccess("Đăng nhập thành công!");
                }

                await Task.Delay(1500); // Đợi một chút để hiển thị thông báo
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Có lỗi xảy ra, vui lòng thử lại";
            Console.WriteLine($"Login error: {ex.Message}");
        }
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= StateHasChanged;
    }
}