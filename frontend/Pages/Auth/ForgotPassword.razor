@page "/forgot-password"
@layout AuthLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Quên mật khẩu - Spot247</PageTitle>

<div>
    <h1 class="text-white text-2xl font-bold text-center mb-8">
        Quên mật khẩu
    </h1>

    <p class="text-gray-400 text-sm mb-6 text-center">
        Nhập email của bạn và chúng tôi sẽ gửi mã OTP để giúp bạn tiến hành cài lại mật khẩu mới.
    </p>

    <EditForm Model="@forgotPasswordRequest" OnValidSubmit="@HandleForgotPassword">
        <DataAnnotationsValidator />

        <div class="space-y-6">
            <div>
                <label for="email" class="block text-sm font-medium text-gray-300 mb-2">
                    Email
                </label>
                <InputText @bind-Value="forgotPasswordRequest.Username" id="email" placeholder="Nhập email của bạn"
                    class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-white placeholder-gray-400" />
                <ValidationMessage For="@(() => forgotPasswordRequest.Username)" class="mt-1 text-sm text-red-400" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mb-4 p-3 bg-red-900/50 border border-red-700 rounded-md">
                    <p class="text-red-300 text-sm">@errorMessage</p>
                </div>
            }

            <ButtonComponent Type="submit" Text="Gửi mã" LoadingText="Đang gửi..." IsLoading="@AuthService.IsLoading"
                Disabled="@AuthService.IsLoading"
                CssClass="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-4 rounded-md transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed" />
        </div>
    </EditForm>

    <div class="mt-6 text-center">
        <a href="/login"
            class="@(AuthService.IsLoading ? "pointer-events-none opacity-70" : "") text-blue-400 hover:text-blue-300 text-sm underline cursor-pointer">
            Quay lại trang đăng nhập
        </a>
    </div>
</div>

<ToastComponent @ref="toastComponent" />

@code {
    private ForgotPasswordRequest forgotPasswordRequest = new();
    private string errorMessage = string.Empty;
    private ToastComponent? toastComponent;

    protected override async Task OnInitializedAsync()
    {
        // Nếu đã đăng nhập, chuyển hướng đến trang chính
        if (AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/");
        }

        AuthService.OnAuthStateChanged += StateHasChanged;
    }

    private async Task HandleForgotPassword()
    {
        errorMessage = string.Empty;

        try
        {
            var result = await AuthService.SendOtpAsync(forgotPasswordRequest.Username);

            if (result == null)
            {
                errorMessage = "Có lỗi xảy ra, vui lòng thử lại";
                return;
            }

            if (result.StatusCode == 200)
            {
                // Gửi OTP thành công
                if (toastComponent != null)
                {
                    await toastComponent.ShowSuccess("Đã gửi mã OTP về email của bạn");
                }

                await Task.Delay(1500); // Đợi một chút để hiển thị thông báo
                Navigation.NavigateTo($"/verify-email?email={Uri.EscapeDataString(forgotPasswordRequest.Username)}&isPasswordReset=true");
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Có lỗi xảy ra, vui lòng thử lại";
            Console.WriteLine($"Forgot password error: {ex.Message}");
        }
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= StateHasChanged;
    }
}