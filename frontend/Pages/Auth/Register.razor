@page "/register"
@layout AuthLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Đăng ký - Spot247</PageTitle>

<div>
    <h1 class="text-white text-2xl font-bold text-center mb-8">
        Đăng ký tài khoản
    </h1>

    <EditForm Model="@registerRequest" OnValidSubmit="@HandleRegister">
        <DataAnnotationsValidator />
        
        <div class="space-y-6">
            <div>
                <label for="email" class="block text-sm font-medium text-gray-300 mb-2">
                    Email
                </label>
                <InputText @bind-Value="registerRequest.Username" 
                          id="email"
                          placeholder="Nhập email của bạn"
                          class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-white placeholder-gray-400" />
                <ValidationMessage For="@(() => registerRequest.Username)" class="mt-1 text-sm text-red-400" />
            </div>

            <div>
                <label for="password" class="block text-sm font-medium text-gray-300 mb-2">
                    Mật khẩu
                </label>
                <InputText @bind-Value="registerRequest.Password" 
                          type="password"
                          id="password"
                          placeholder="Nhập mật khẩu (tối thiểu 8 ký tự)"
                          class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-white placeholder-gray-400" />
                <ValidationMessage For="@(() => registerRequest.Password)" class="mt-1 text-sm text-red-400" />
            </div>

            <div>
                <label for="confirmPassword" class="block text-sm font-medium text-gray-300 mb-2">
                    Xác nhận mật khẩu
                </label>
                <InputText @bind-Value="registerRequest.ConfirmPassword" 
                          type="password"
                          id="confirmPassword"
                          placeholder="Nhập lại mật khẩu"
                          class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-white placeholder-gray-400" />
                <ValidationMessage For="@(() => registerRequest.ConfirmPassword)" class="mt-1 text-sm text-red-400" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mb-4 p-3 bg-red-900/50 border border-red-700 rounded-md">
                    <p class="text-red-300 text-sm">@errorMessage</p>
                </div>
            }

            <ButtonComponent 
                Type="submit"
                Text="Đăng ký"
                LoadingText="Đang đăng ký..."
                IsLoading="@AuthService.IsLoading"
                Disabled="@AuthService.IsLoading"
                CssClass="w-full bg-green-600 hover:bg-green-700 text-white font-medium py-3 px-4 rounded-md transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed" />
        </div>
    </EditForm>

    <div class="mt-6 text-center">
        <p class="text-gray-400 text-sm">
            Đã có tài khoản? 
            <a href="/login" 
               class="@(AuthService.IsLoading ? "pointer-events-none opacity-70" : "") text-blue-400 hover:text-blue-300 underline cursor-pointer">
                Đăng nhập ngay
            </a>
        </p>
    </div>
</div>

<ToastComponent @ref="toastComponent" />

@code {
    private RegisterRequest registerRequest = new();
    private string errorMessage = string.Empty;
    private ToastComponent? toastComponent;

    protected override async Task OnInitializedAsync()
    {
        // Nếu đã đăng nhập, chuyển hướng đến trang chính
        if (AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/");
        }

        AuthService.OnAuthStateChanged += StateHasChanged;
    }

    private async Task HandleRegister()
    {
        errorMessage = string.Empty;

        try
        {
            var result = await AuthService.RegisterAsync(registerRequest);

            if (result == null)
            {
                errorMessage = "Có lỗi xảy ra, vui lòng thử lại";
                return;
            }

            if (result.StatusCode == 201)
            {
                // Đăng ký thành công
                if (toastComponent != null)
                {
                    await toastComponent.ShowSuccess("Đăng ký thành công! Vui lòng đăng nhập.");
                }
                
                await Task.Delay(2000); // Đợi một chút để hiển thị thông báo
                Navigation.NavigateTo("/login");
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Có lỗi xảy ra, vui lòng thử lại";
            Console.WriteLine($"Register error: {ex.Message}");
        }
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= StateHasChanged;
    }
}